# Database (use "db" as host when running via docker compose)
DATABASE_URL=postgresql+asyncpg://weather:weather@localhost:5432/weatheredge

# Telegram alerts (leave empty for dry-run mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading parameters
MIN_EDGE=0.10
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.05
INITIAL_BANKROLL=750

# Polymarket execution (leave PRIVATE_KEY empty for dry-run)
POLYMARKET_PRIVATE_KEY=
AUTO_EXECUTE=false
DAILY_SPEND_CAP_USD=200
MIN_STAKE_USD=5

# Master kill for bracket-like NO (`exactly`/`range`/`bracket` BUY_NO) in
# the probability path while lead-time-aware σ recalibration is pending
# (see docs/improvements.md). Default False = no behavior change. Flip
# True to stop a structurally -EV class — preserves threshold ops,
# `exactly` YES, and all lock-path range YES branches.
BRACKET_LIKE_NO_DISABLED=false
